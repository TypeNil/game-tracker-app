<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup: user library (statuses, ratings, notes, favorites, hours) exists
     only in Room (gametracker.db) with no server sync. Excluding it or setting
     allowBackup=false would irreversibly wipe the collection on reinstall.
     Cache tables share the same DB file (per-table includes are unsupported),
     so the whole DB is preserved. See data_extraction_rules.xml for API 31+. -->
<full-backup-content>
    <include domain="database" path="gametracker.db" />
</full-backup-content>