<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ cloud backup / device transfer. Same constraint as backup_rules.xml:
     library_entries is user-owned, Room-only, no server sync — the whole
     gametracker.db must be preserved or reinstall wipes the collection. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="gametracker.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gametracker.db" />
    </device-transfer>
</data-extraction-rules>