# Reference environment variables for GameTracker BFF (:backend).
# NOTE: The Ktor application does NOT automatically load .env files at runtime.
# It reads real system environment variables or properties from root local.properties
# when launched via Gradle (:backend:run).

# Twitch / IGDB API credentials (https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Server network binding configuration
PORT=8080
HOST=127.0.0.1
